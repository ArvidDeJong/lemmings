includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    ignoreErrors:
        # Larastan only looks for views in resources/views of the analysed app. It cannot resolve a
        # view under the package namespace the provider registers with loadViewsFrom(). The views
        # exist: tests/Feature/ServiceProviderTest.php asserts them. One for the easter egg page,
        # one for the packages page.
        -
            identifier: argument.type
            message: '#view-string\|null, string given#'
            path: src/Laravel/routes/web.php
            count: 2
